# AlloAgent environment configuration
#
# Copy this file to .env and fill in the values you need.  Every name
# below is one the code reads; the comment says where.

# --- the agent ---

# The model to run (biomni/config.py; BIOMNI_LLM_MODEL is the older alias).
BIOMNI_LLM=your_model_name_here

# The provider: OpenAI, AzureOpenAI, Anthropic, Ollama, Gemini, Bedrock,
# Groq or Custom.  When it is unset, the provider is guessed from the model
# name; biomni/llm.py reads LLM_SOURCE as a fallback.
BIOMNI_SOURCE=Anthropic

# Where the Biomni data lake is kept (biomni/config.py; BIOMNI_PATH is the
# older alias).
BIOMNI_DATA_PATH=./data

# The per-call timeout, in seconds (biomni/config.py).
BIOMNI_TIMEOUT_SECONDS=600

# --- a custom, OpenAI-compatible endpoint ---

# The base URL and the key of a custom endpoint - MiniMax-M3 is served at
# https://api.minimax.io/v1 (biomni/config.py).
BIOMNI_CUSTOM_BASE_URL=https://your-endpoint/v1
BIOMNI_CUSTOM_API_KEY=your_custom_api_key_here

# --- the provider keys: uncomment the one your provider needs ---

# Anthropic (biomni/llm.py).
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI, and Azure OpenAI together with its endpoint (biomni/llm.py).
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# Gemini (biomni/llm.py).
# GEMINI_API_KEY=your_gemini_api_key_here

# Groq (biomni/llm.py).
# GROQ_API_KEY=your_groq_api_key_here

# AWS Bedrock: the region (biomni/llm.py) and the standard AWS credentials,
# which the AWS SDK reads from the environment.
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
